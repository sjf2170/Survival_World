<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Survival World Inventory</title>
  <style>
    body { font-family: sans-serif; padding: 2em; background: #f0f4f8; }
    #inventory-list { margin-top: 1em; }
    .item-tag {
      background: #4f46e5;
      color: white;
      padding: 5px 10px;
      border-radius: 9999px;
      margin: 4px;
      display: inline-block;
    }
  </style>
</head>
<body>
  <h1>Inventory Tracker</h1>

  <form method="POST">
    <input list="resources" name="resource" placeholder="Select or type a resource...">
    <datalist id="resources">
      <!-- Items will be populated by Python backend -->
      {% for item in resource_list %}
        <option value="{{ item }}">
      {% endfor %}
    </datalist>
    <button type="submit">Add</button>
  </form>

  <div id="inventory-list">
    {% for item in inventory %}
      <span class="item-tag">{{ item }}</span>
    {% endfor %}
  </div>
</body>
</html>
